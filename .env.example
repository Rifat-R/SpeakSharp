# Copy this file to .env and fill in your keys.

# Required
ELEVENLAB_API_KEY=
OPENAI_API_KEY=

# Optional
OPENAI_MODEL=gpt-4o-mini

# Deployment
# Set APP_ENV=development for local work. Production fails closed without a
# demo password and a strong session secret.
APP_ENV=production
DEMO_PASSWORD=
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=86400
SESSION_HTTPS_ONLY=true
CORS_ORIGINS=https://speakbetter.duckdns.org
